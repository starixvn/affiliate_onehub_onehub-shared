<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EasyNetQ" Version="7.8.0" />
    <PackageReference Include="Fanex.Data.ProxyClient" Version="1.0.6.1" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="libphonenumber-csharp" Version="9.0.17" />
    <PackageReference Include="MessagePack" Version="3.1.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="ONEbook.UM" Version="3.2.6" />
    <PackageReference Include="Polly" Version="8.6.4" />
    <PackageReference Include="Serilog.Sinks.Network" Version="3.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.32" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\ValidationMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ValidationMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\UI.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>UI.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ValidationMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ValidationMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\UI.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>UI.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\UI.vi.resx">
      <DependentUpon>UI.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\UI.th.resx">
      <DependentUpon>UI.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\UI.zh-CN.resx">
      <DependentUpon>UI.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\UI.te-IN.resx">
      <DependentUpon>UI.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>